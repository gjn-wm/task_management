# Copy to .env and fill in. .env is gitignored.

# Required
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/gjn_db
# Signs session cookies; generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Optional
# Password for the first Admin, used only when the users table is empty.
# If unset, a random one is generated and printed to the server log once.
#INITIAL_ADMIN_PASSWORD=
# Docker container that runs pg_dump for /api/backups (credentials come from DATABASE_URL)
BACKUP_PG_CONTAINER=postgres18
# Max attachment size in MB (default 25)
#MAX_UPLOAD_MB=25

# Biometric time test: attendance API for the RS9N (LAN address)
RS9N_API_BASE=http://192.168.29.101:5004
RS9N_API_TOKEN=
